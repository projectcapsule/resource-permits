{
  "name": "resource-permits",
  "version": "0.1.0",
  "description": "ResourcePermit requests, template catalogs, review and lifecycle management for Headlamp.",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "vite build --config vite.config.mjs",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "headlamp-plugin test"
  },
  "keywords": [
    "headlamp",
    "capsule",
    "resource-permits"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0"
  },
  "dependencies": {
    "@rjsf/core": "^5.24.13",
    "@rjsf/mui": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@xyflow/react": "^12.11.0",
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "recharts": "^3.8.1"
  }
}
